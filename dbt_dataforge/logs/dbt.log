  create  table "dataforge_dw"."gold"."dim_locations__dbt_tmp"
  
  
    as
  
  (
    -- models/marts/dim_locations.sql                                                               
    with distinct_locations as (                                                                    
        select distinct                                                                             
            latitude,                                                                               
            longitude                                                                               
        from "dataforge_dw"."gold"."stg_field_orders"                                                          
