        valor_fatura,                                                                               
        hora_leitura,                                                                               
        status_leitura,                                                                             
                                                                                                    
        -- Data de Carga no Data Warehouse                                                          
        current_timestamp as data_processamento_dw                                                  
                                                                                                    
    from stg_orders
  );
  
