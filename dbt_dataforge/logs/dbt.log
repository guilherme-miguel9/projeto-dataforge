    )                                                                                               
                                                                                                    
    select                                                                                          
        -- Chave Primária da Ordem                                                                  
        numero_item_ordem,                                                                          
                                                                                                    
        -- Chaves Estrangeiras (FKs) ligando com as Dimensões!                                      
